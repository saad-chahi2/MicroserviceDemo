<?xml version="1.0" encoding="utf-8"?>
<!-- Sources NuGet du repo : ignore les feeds configurés sur la machine (feeds privés d'entreprise, etc.)
     → même résultat sur ton PC, dans Docker et sur GitHub Actions. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
